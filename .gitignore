!data/predictions/all_forms/flan_t5_*_all_forms_predictions.jsonl
logs/
outputs/*
!outputs/final/
outputs/final/*
!outputs/final/*_cot_allforms_sample[0-4]_outputs_log.csv
.venv/
__pycache__/
*.pyc
.DS_Store
slurm-*.out
.ipynb_checkpoints/
